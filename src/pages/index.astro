---
import { getCollection, getEntry } from 'astro:content';
import PageIndex from '../components/pages/PageIndex.astro';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Tambahkan src/content/pages/home.md');
const [services, articles] = await Promise.all([getCollection('services'), getCollection('articles')]);
---
<PageIndex page={home} services={services} articles={articles} />
