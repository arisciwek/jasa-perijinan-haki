---
import { getCollection } from 'astro:content';
import PageShell from '../../components/shared/PageShell.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import ArticleCard from '../../components/shared/ArticleCard.astro';
const articles = (await getCollection('articles')).filter((a) => !a.data.draft).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<PageShell title="Artikel Perizinan Usaha dan HAKI" description="Panduan dan wawasan tentang perizinan usaha, legalitas, merek, hak cipta, dan paten." canonical="/articles/" image="/images/og-default.svg">
  <section class="mx-auto max-w-7xl px-5 py-12 md:py-16"><Breadcrumbs items={[{ label: 'Artikel' }]} /><p class="text-sm font-bold uppercase tracking-wider text-blue-700">Pusat informasi</p><h1 class="mt-3 text-4xl font-extrabold tracking-tight text-slate-950 md:text-5xl">Artikel dan panduan</h1><p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">Informasi untuk membantu Anda memahami proses perizinan usaha dan perlindungan kekayaan intelektual.</p><div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{articles.map((article) => <ArticleCard article={article} />)}</div></section>
</PageShell>
