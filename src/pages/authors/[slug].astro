---
import { getCollection } from 'astro:content';
import PageShell from '../../components/shared/PageShell.astro';
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro';
import ArticleCard from '../../components/shared/ArticleCard.astro';
export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { slug: author.data.slug }, props: { author } }));
}
const { author } = Astro.props;
const articles = (await getCollection('articles')).filter((a) => !a.data.draft && a.data.author === author.data.slug).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<PageShell title={`Artikel oleh ${author.data.name}`} description={author.data.bio} canonical={`/authors/${author.data.slug}/`}>
  <section class="mx-auto max-w-7xl px-5 py-12"><Breadcrumbs items={[{ label: 'Penulis' }, { label: author.data.name }]} /><h1 class="text-4xl font-extrabold text-slate-950">{author.data.name}</h1><p class="mt-4 max-w-3xl leading-7 text-slate-600">{author.data.bio}</p><div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{articles.map((article) => <ArticleCard article={article} />)}</div></section>
</PageShell>
