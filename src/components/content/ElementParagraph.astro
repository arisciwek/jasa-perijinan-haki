---
/**
 * ElementParagraph — elemen `{ type: "p", text }` di block "card".
 * Props: text (wajib) — dirender apa adanya, tanpa format markdown inline.
 * Contoh: - type: "p" \n text: "Paragraf..."
 */
const { text } = Astro.props as { text: string };
---
<p class="mt-3 leading-8 text-slate-600">{text}</p>
