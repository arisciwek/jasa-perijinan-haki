---
/**
 * BodyElements — kompositor elemen konten block "card".
 *
 * Menerima array `body` bertipe dari frontmatter lalu memanggil komponen
 * elemen sesuai `type` (registry di sini, cermin dari blocks.ts):
 *   p     -> ElementParagraph  { text }
 *   list  -> ElementList       { ordered?, items }
 *   image -> ElementFigure     { src, alt, caption? }
 *
 * Elemen dengan `type` tak dikenal dilewati (tidak merender apa pun).
 * Dipanggil dari ContentCard.astro; tidak dipanggil langsung dari markdown.
 *
 * Props:
 * - body?: Array elemen bertipe (lihat schema `blocks` di src/content.config.ts).
 */
import ElementParagraph from './ElementParagraph.astro';
import ElementList from './ElementList.astro';
import ElementFigure from './ElementFigure.astro';
const { body = [] } = Astro.props as { body?: any[] };
const elements: Record<string, any> = {
  p: ElementParagraph,
  list: ElementList,
  image: ElementFigure,
};
const rendered = (body ?? [])
  .map((element: any) => ({ ...element, C: elements[element.type] }))
  .filter((element: { C?: any }) => !!element.C);
---
{rendered.map(({ C, type, ...props }: { C: any; type: string; [key: string]: any }) => <C {...props} />)}
