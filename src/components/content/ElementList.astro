---
/**
 * ElementList — elemen `{ type: "list", ordered?, items }` di block "card".
 * Props:
 * - ordered?: boolean — false (default) -> <ul> bullet; true -> <ol> bernomor
 * - items: string[] (wajib, min. 1) — teks per item, tanpa markdown inline.
 * Contoh: - type: "list" \n ordered: true \n items: ["Satu", "Dua"]
 */
const { ordered = false, items = [] } = Astro.props as { ordered?: boolean; items: string[] };
const Tag = ordered ? 'ol' : 'ul';
const classes = ordered
  ? 'mt-3 list-decimal space-y-2 pl-5 leading-8 text-slate-600 marker:font-semibold marker:text-blue-700'
  : 'mt-3 list-disc space-y-2 pl-5 leading-8 text-slate-600 marker:text-blue-700';
---
<Tag class={classes}>{items.map((item) => <li>{item}</li>)}</Tag>
