---
/**
 * ElementFigure — elemen `{ type: "image", src, alt, caption? }` di block "card".
 * Props:
 * - src: string (wajib) — path gambar dari /public, contoh: "/images/contoh.svg"
 * - alt: string (wajib) — teks alternatif aksesibel
 * - caption?: string — keterangan <figcaption> di bawah gambar
 * Gambar dirender lazy + async, ring halus di tepi.
 */
const { src, alt, caption } = Astro.props as { src: string; alt: string; caption?: string };
---
<figure class="mt-5">
  <img src={src} alt={alt} loading="lazy" decoding="async" width="800" height="600" class="w-full rounded-xl ring-1 ring-slate-200" />
  {caption && <figcaption class="mt-2 text-sm text-slate-500">{caption}</figcaption>}
</figure>
