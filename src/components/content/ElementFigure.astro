---
/**
 * ElementFigure — elemen `{ type: "image", src, alt, caption? }` di block "card".
 * Props:
 * - src: string (wajib) — path gambar dari /public, contoh: "/images/contoh.svg"
 * - alt: string (wajib) — teks alternatif aksesibel
 * - caption?: string — keterangan <figcaption> di bawah gambar
 * - class?: string — kelas <figure>; DEFAULT: "mt-5"
 * - imgClass?: string — kelas <img>; DEFAULT: "w-full rounded-xl ring-1 ring-slate-200"
 * - captionClass?: string — kelas <figcaption>; DEFAULT: "mt-2 text-sm text-slate-500"
 * Gambar dirender lazy + async.
 */
const { src, alt, caption, class: className = 'mt-5', imgClass = 'w-full rounded-xl ring-1 ring-slate-200', captionClass = 'mt-2 text-sm text-slate-500' } = Astro.props as { src: string; alt: string; caption?: string; class?: string; imgClass?: string; captionClass?: string };
---
<figure class={className}>
  <img src={src} alt={alt} loading="lazy" decoding="async" width="800" height="600" class={imgClass} />
  {caption && <figcaption class={captionClass}>{caption}</figcaption>}
</figure>
