---
import PageShell from '../shared/PageShell.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
import PageUpdatedArticles from '../shared/PageUpdatedArticles.astro';
import ServiceCard from '../shared/ServiceCard.astro';
import HomeCTA from '../home/HomeCTA.astro';
import type { CollectionEntry } from 'astro:content';
const { page, services = [], articles = [], group } = Astro.props as {
  page: CollectionEntry<'pages'>;
  services?: CollectionEntry<'services'>[];
  articles?: CollectionEntry<'articles'>[];
  group?: string;
};
const visibleServices = services.filter((s) => !s.data.draft && (!group || s.data.serviceGroup === group)).sort((a, b) => a.data.order - b.data.order);
---
<PageShell title={page.data.seoTitle ?? page.data.title} description={page.data.description} canonical={`/${page.data.slug}/`} image={page.data.image}>
  <section class="mx-auto max-w-7xl px-5 py-12 md:py-16">
    <Breadcrumbs items={[{ label: page.data.title }]} />
    <p class="text-sm font-bold uppercase tracking-wider text-blue-700">Layanan</p>
    <h1 class="mt-3 max-w-4xl text-4xl font-extrabold tracking-tight text-slate-950 md:text-5xl">{page.data.title}</h1>
    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">{page.data.description}</p>
    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{visibleServices.map((service) => <ServiceCard service={service} />)}</div>
  </section>
  <PageUpdatedArticles articles={articles} heading="Artikel Terkait" description="Bacaan terbaru untuk membantu Anda memahami bidang layanan ini." />
  <HomeCTA />
</PageShell>
