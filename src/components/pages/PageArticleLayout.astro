---
/**
 * Layout artikel: sidebar TOC/layanan/penulis + konten + block dinamis.
 *
 * Block berasal dari frontmatter artikel (`blocks: [...]`), dirender
 * generik via src/components/blocks.ts: <C id={anchor} {...props} />.
 * - anchor = block.id ?? `${component}-${index+1}` (unik per halaman)
 * - component tak terdaftar di blocks.ts dilewati (tidak merender apa pun)
 * - heading tiap block otomatis masuk "Daftar Isi" di sidebar (depth 2)
 * Daftar block yang tersedia + contoh frontmatter: lihat blocks.ts.
 */
import PageShell from '../shared/PageShell.astro';
import Breadcrumbs from '../shared/Breadcrumbs.astro';
import RelatedArticles from '../shared/RelatedArticles.astro';
import ArticleSidebar from '../shared/ArticleSidebar.astro';
import blocks from '../blocks';
const { article, articles = [], authorName, authorBio = '', service = null, headings = [] } = Astro.props;
const blockComponents = (article.data.blocks ?? [])
  .map((block: { component: string; id?: string; heading: string; icon?: string; body?: any[] }, index: number) => ({ ...block, anchor: block.id ?? `${block.component}-${index + 1}`, C: blocks[block.component] }))
  .filter((block: { C?: any }) => !!block.C);
const toc = [...headings.filter((h: { depth: number }) => h.depth <= 3), ...blockComponents.map((block: { anchor: string; heading: string }) => ({ depth: 2, slug: block.anchor, text: block.heading }))];
---
<PageShell title={article.data.title} description={article.data.description} canonical={`/articles/${article.data.slug}/`} image={article.data.image}>
  <div class="mx-auto max-w-7xl px-5 py-12 md:py-16">
    <Breadcrumbs items={[{ label: 'Artikel', href: '/articles/' }, { label: article.data.title }]} />
    <div class="article-layout mt-6 grid grid-cols-12 gap-8">
      <div class="article-layout__sidebar col-span-12 hidden lg:col-span-3 lg:block">
        <div class="sticky top-8">
          <ArticleSidebar headings={toc} service={service} authorName={authorName ?? article.data.author} authorBio={authorBio} />
        </div>
      </div>
      <div class="article-layout__main col-span-12 lg:col-span-9">
        <article class="mx-auto max-w-3xl">
          {article.data.category && <p class="text-sm font-bold uppercase tracking-wider text-blue-700">{article.data.category}</p>}
          <h1 class="mt-3 text-4xl font-extrabold leading-tight tracking-tight text-slate-950 md:text-5xl">{article.data.title}</h1>
          <p class="mt-5 text-xl leading-8 text-slate-600">{article.data.description}</p>
          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm text-slate-500"><span>{authorName ?? article.data.author ?? 'Tim Redaksi'}</span><time datetime={article.data.pubDate.toISOString()}>{article.data.pubDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</time>{article.data.updatedDate && <span>Diperbarui {article.data.updatedDate.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}</span>}</div>
          <div class="prose-content mt-10"><slot /></div>
          {blockComponents.map(({ C, anchor, ...block }: { C: any; anchor: string; [key: string]: any }) => <C id={anchor} {...block} />)}
          {article.data.relatedType && article.data.relatedId ? <RelatedArticles articles={articles} type={article.data.relatedType} id={article.data.relatedId} excludeId={article.data.id} /> : null}
          <div class="mt-12"><a href="/contact/" class="font-semibold text-blue-700">Diskusikan kebutuhan Anda →</a></div>
        </article>
      </div>
    </div>
  </div>
</PageShell>
