---
import PageShell from '../shared/PageShell.astro';
import HomeHero from '../home/HomeHero.astro';
import HomeServices from '../home/HomeServices.astro';
import HomeAdvantages from '../home/HomeAdvantages.astro';
import HomeProcess from '../home/HomeProcess.astro';
import PageUpdatedArticles from '../shared/PageUpdatedArticles.astro';
import HomeCTA from '../home/HomeCTA.astro';
const { page, services, articles } = Astro.props;
---
<PageShell title={page.data.seoTitle ?? page.data.title} description={page.data.description} canonical="/">
  <HomeHero title={page.data.title} description={page.data.description} />
  <HomeServices services={services} />
  <HomeAdvantages />
  <HomeProcess />
  <PageUpdatedArticles articles={articles} heading="Artikel Terbaru" description="Baca pembaruan dan panduan seputar perizinan usaha serta kekayaan intelektual." />
  <HomeCTA />
</PageShell>
