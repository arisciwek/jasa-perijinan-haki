---
import Icon from '../shared/Icon.astro';
const steps = [
  ['user-question', 'Konsultasi awal', 'Sampaikan bidang usaha, kebutuhan, dan target yang ingin dicapai.'],
  ['clipboard-check', 'Pemetaan kebutuhan', 'Ruang lingkup, dokumen, tahapan, serta hal yang perlu dikonfirmasi dipetakan.'],
  ['rocket', 'Pelaksanaan dan tindak lanjut', 'Proses dilakukan berdasarkan kesepakatan dan persyaratan yang berlaku.'],
];
---
<section class="mx-auto max-w-7xl px-5 py-16"><div class="max-w-2xl"><p class="text-sm font-bold uppercase tracking-wider text-blue-700">Alur kerja</p><h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">Mulai dari kebutuhan yang paling penting</h2></div><div class="mt-8 grid gap-6 md:grid-cols-3">{steps.map(([icon, title, text]) => <div class="border-l-2 border-blue-600 pl-5"><span class="inline-flex rounded-xl bg-blue-50 p-2.5 text-blue-700"><Icon name={icon} size={24} /></span><h3 class="mt-3 text-lg font-bold text-slate-950">{title}</h3><p class="mt-2 leading-7 text-slate-600">{text}</p></div>)}</div></section>
