---
import ServiceCard from '../shared/ServiceCard.astro';
const { services = [] } = Astro.props;
const featured = [...services].filter((s) => !s.data.draft).sort((a,b) => a.data.order - b.data.order).slice(0, 6);
---
<section class="mx-auto max-w-7xl px-5 py-16">
  <div class="max-w-2xl"><p class="text-sm font-bold uppercase tracking-wider text-blue-700">Layanan kami</p><h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">Dukungan legalitas untuk kebutuhan bisnis</h2><p class="mt-4 leading-7 text-slate-600">Pilih bidang layanan untuk melihat ruang lingkup, tahapan, persyaratan, dan informasi yang relevan.</p></div>
  <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3">{featured.map((service) => <ServiceCard service={service} />)}</div>
  <div class="mt-8"><a href="/services/" class="font-semibold text-blue-700">Lihat semua layanan →</a></div>
</section>
