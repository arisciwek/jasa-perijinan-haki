---
import Icon from '../shared/Icon.astro';
const items = [
  { id: 'ruang-lingkup-jelas', icon: 'target', title: 'Ruang lingkup jelas', text: 'Kebutuhan dan cakupan pekerjaan dibahas sebelum proses dimulai.' },
  { id: 'informasi-terstruktur', icon: 'file-text', title: 'Informasi terstruktur', text: 'Persyaratan dan tahapan disampaikan agar lebih mudah dipahami.' },
  { id: 'pendampingan-sesuai-kebutuhan', icon: 'messages', title: 'Pendampingan sesuai kebutuhan', text: 'Pendekatan disesuaikan dengan bidang usaha dan tujuan klien.' },
];
---
<section class="bg-slate-50"><div class="mx-auto max-w-7xl px-5 py-16"><div class="max-w-2xl"><p class="text-sm font-bold uppercase tracking-wider text-blue-700">Cara kami membantu</p><h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">Informasi yang jelas, proses yang terarah</h2></div><div class="mt-8 grid gap-5 md:grid-cols-3">{items.map((item) => <article id={item.id} class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200"><span class="inline-flex rounded-xl bg-blue-50 p-2.5 text-blue-700"><Icon name={item.icon} size={24} /></span><h3 class="mt-4 text-lg font-bold text-slate-950">{item.title}</h3><p class="mt-2 leading-7 text-slate-600">{item.text}</p></article>)}</div></div></section>
