---
const { title = 'Mari diskusikan kebutuhan bisnis Anda', description = 'Ceritakan kebutuhan perizinan atau kekayaan intelektual Anda untuk mengetahui langkah berikutnya.', buttonLabel = 'Hubungi Tim Kami' } = Astro.props;
---
<section class="mx-auto max-w-7xl px-5 py-8"><div class="rounded-3xl bg-blue-700 px-7 py-10 text-white md:flex md:items-center md:justify-between md:gap-8 md:px-12"><div><h2 class="text-2xl font-extrabold md:text-3xl">{title}</h2><p class="mt-3 max-w-2xl leading-7 text-blue-100">{description}</p></div><a href="/contact/" class="mt-6 inline-flex shrink-0 rounded-lg bg-white px-5 py-3 font-bold text-blue-800 hover:bg-blue-50 md:mt-0">{buttonLabel}</a></div></section>
