---
/**
 * TableBlock — block "table" (tabel perbandingan).
 *
 * Merender: ikon + heading (opsional) + tabel HTML dari frontmatter.
 * Dibungkus overflow-x-auto agar bisa digeser horizontal di layar kecil.
 * Untuk aksesibilitas: <th scope="col"> pada tiap kolom.
 *
 * Props:
 * - id?:     string — anchor HTML & slug TOC (jika heading diisi)
 * - heading?: string — judul h2 section (opsional)
 * - icon?:   string — nama ikon Tabler, default "file-stack" (daftar: Icon.astro)
 * - head:    string[] — kolom header tabel (wajib, min. 1)
 * - rows:    string[][] — baris tabel (wajib, min. 1); jumlah sel mengikuti kolom
 * - class?:  object — kelas tiap bagian; key yang tidak diisi memakai DEFAULT:
 *              section: "mt-10 rounded-2xl border border-slate-200 bg-white p-6 md:p-8"
 *              icon:    "inline-flex rounded-xl bg-blue-50 p-2.5 text-blue-700 shadow-sm"
 *              heading: "mt-4 text-2xl font-extrabold tracking-tight text-slate-950"
 *              wrapper: "mt-4 overflow-x-auto"
 *              table:   "w-full border-collapse text-left text-sm"
 * *              table:   "w-full border-collapse text-left text-sm"
 *              th:      "border-b border-blue-200 bg-blue-50 px-4 py-3 text-left font-semibold text-blue-950"  (header row berwarna)
 *              row:     "odd:bg-white even:bg-slate-50"                 (zebra striping pada tbody)
 *              td:      "border-b border-slate-100 px-4 py-3 align-top leading-7 text-slate-600"
 *
 * Contoh pemakaian di frontmatter artikel (src/content/articles/*.md):
 *   blocks:
 *     - component: "table"
 *       id: "perbandingan"
 *       heading: "Perbandingan singkat"
 *       head: ["Aspek", "Merek", "Paten"]
 *       rows:
 *         - ["Objek", "Tanda pembeda", "Invensi teknis"]
 *         - ["Cara memperoleh", "Pendaftaran", "Pengajuan + penelaahan"]
 */
import Icon from './Icon.astro';
const { id, heading, icon = 'file-stack', class: cls = {}, head = [], rows = [] } = Astro.props as { id?: string; heading?: string; icon?: string; class?: Record<string, string>; head?: string[]; rows?: string[][] };
const classes = {
  section: 'mt-10 rounded-2xl border border-slate-200 bg-white p-6 md:p-8',
  icon: 'inline-flex rounded-xl bg-blue-50 p-2.5 text-blue-700 shadow-sm',
  heading: 'mt-4 text-2xl font-extrabold tracking-tight text-slate-950',
  wrapper: 'mt-4 overflow-x-auto',
  table: 'w-full border-collapse text-left text-sm',
  th: 'border-b border-blue-200 bg-blue-50 px-4 py-3 text-left font-semibold text-blue-950',
  row: 'odd:bg-white even:bg-slate-50',
  td: 'border-b border-slate-100 px-4 py-3 align-top leading-7 text-slate-600',
  ...cls,
};
---
<section id={id} class={classes.section}>
  <span class={classes.icon}><Icon name={icon ?? 'file-stack'} size={24} /></span>
  {heading && <h2 class={classes.heading}>{heading}</h2>}
  <div class={classes.wrapper}>
    <table class={classes.table}>
      <thead><tr>{head.map((cell) => <th scope="col" class={classes.th}>{cell}</th>)}</tr></thead>
      <tbody>{rows.map((row) => <tr class={classes.row}>{row.map((cell) => <td class={classes.td}>{cell}</td>)}</tr>)}</tbody>
    </table>
  </div>
</section>
