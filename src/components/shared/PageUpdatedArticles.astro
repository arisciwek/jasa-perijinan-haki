---
import ArticleCard from './ArticleCard.astro';
const { articles = [], heading = 'Artikel Terbaru', description = 'Wawasan dan panduan praktis untuk bisnis Anda.' } = Astro.props;
const latest = [...articles].filter((item) => !item.data.draft).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<section class="mx-auto max-w-7xl px-5 py-16">
  <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div><p class="text-sm font-bold uppercase tracking-wider text-blue-700">Insight & panduan</p><h2 class="mt-2 text-3xl font-extrabold tracking-tight text-slate-950">{heading}</h2><p class="mt-3 max-w-2xl text-slate-600">{description}</p></div>
    <a href="/articles/" class="font-semibold text-blue-700 hover:text-blue-900">Semua artikel →</a>
  </div>
  {latest.length ? <div class="grid gap-5 md:grid-cols-3">{latest.map((article) => <ArticleCard article={article} />)}</div> : <p class="rounded-xl border border-dashed border-slate-300 p-8 text-slate-500">Artikel akan ditampilkan di sini setelah konten diterbitkan.</p>}
</section>
