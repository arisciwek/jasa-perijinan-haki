---
/**
 * FaqBlock — block "faq" (accordion tanya-jawab).
 *
 * Merender: ikon + heading h2 + daftar accordion <details>/<summary>
 * native — tanpa JavaScript, keyboard- & screen-reader-friendly;
 * chevron berotasi otomatis saat item terbuka (group-open:rotate-180).
 *
 * Props:
 * - id?:     string — anchor HTML & slug TOC; fallback otomatis `${component}-${index+1}`
 * - heading: string — judul h2 section (wajib)
 * - icon?:   string — nama ikon Tabler, default "messages" (daftar: Icon.astro)
 * - class?:  string — kelas section block; DEFAULT: "mt-10 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 md:p-8".
 *              Tulis ulang seluruh string di frontmatter untuk mengubah gaya/warna, contoh varian hijau:
 *              "mt-10 rounded-2xl border border-emerald-100 bg-emerald-50/60 p-6 md:p-8"
 * - items:   Array<{ question: string; answer: string }> — min. 1 item (wajib)
 *
 * Contoh pemakaian di frontmatter artikel (src/content/articles/*.md):
 *   blocks:
 *     - component: "faq"
 *       id: "tanya-jawab"
 *       heading: "Pertanyaan yang sering diajukan"
 *       icon: "messages"
 *       class: "mt-10 rounded-2xl border border-emerald-100 bg-emerald-50/60 p-6 md:p-8"
 *       items:
 *         - question: "Apakah daftar dokumen sama untuk semua jenis usaha?"
 *           answer: "Tidak. Daftar menyesuaikan bentuk badan usaha dan kegiatan."
 *         - question: "Apakah dokumen dapat dikirim bertahap?"
 *           answer: "Ya, dokumen inti lebih dahulu, sisanya menyusul."
 */
import Icon from './Icon.astro';
const { id, heading, icon = 'messages', class: className = 'mt-10 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 md:p-8', items = [] } = Astro.props as { id?: string; heading: string; icon?: string; class?: string; items?: { question: string; answer: string }[] };
---
<section id={id} class={className}>
  <span class="inline-flex rounded-xl bg-white p-2.5 text-blue-700 shadow-sm"><Icon name={icon ?? 'messages'} size={24} /></span>
  <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-950">{heading}</h2>
  <div class="mt-4 space-y-3">
    {items.map((item) => (
      <details class="group rounded-xl bg-white ring-1 ring-slate-200 transition-shadow open:ring-blue-300">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-slate-950 [&::-webkit-details-marker]:hidden">
          {item.question}
          <span class="inline-flex shrink-0 rounded-lg bg-blue-50 p-1.5 text-blue-700 transition-transform group-open:rotate-180"><Icon name="chevron-down" size={16} /></span>
        </summary>
        <p class="border-t border-slate-100 px-4 pb-4 pt-3 leading-7 text-slate-600">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
