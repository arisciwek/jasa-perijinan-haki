---
import Icon from './Icon.astro';
const { id, heading, icon = 'messages', items = [] } = Astro.props as { id?: string; heading: string; icon?: string; items?: { question: string; answer: string }[] };
---
<section id={id} class="mt-10 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 md:p-8">
  <span class="inline-flex rounded-xl bg-white p-2.5 text-blue-700 shadow-sm"><Icon name={icon ?? 'messages'} size={24} /></span>
  <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-950">{heading}</h2>
  <div class="mt-4 space-y-3">
    {items.map((item) => (
      <details class="group rounded-xl bg-white ring-1 ring-slate-200 transition-shadow open:ring-blue-300">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 font-semibold text-slate-950 [&::-webkit-details-marker]:hidden">
          {item.question}
          <span class="inline-flex shrink-0 rounded-lg bg-blue-50 p-1.5 text-blue-700 transition-transform group-open:rotate-180"><Icon name="chevron-down" size={16} /></span>
        </summary>
        <p class="border-t border-slate-100 px-4 pb-4 pt-3 leading-7 text-slate-600">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
