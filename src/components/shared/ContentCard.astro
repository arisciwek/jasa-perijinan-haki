---
import Icon from './Icon.astro';
type Paragraph = { type: 'p'; text: string };
type ListBlock = { type: 'list'; ordered?: boolean; items: string[] };
type ImageBlock = { type: 'image'; src: string; alt: string; caption?: string };
type BlockElement = Paragraph | ListBlock | ImageBlock;
const { id, heading, icon = 'circle-check', body = [] } = Astro.props as { id?: string; heading: string; icon?: string; body?: BlockElement[] };
---
<section id={id} class="mt-10 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 md:p-8">
  <span class="inline-flex rounded-xl bg-white p-2.5 text-blue-700 shadow-sm"><Icon name={icon ?? 'circle-check'} size={24} /></span>
  <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-950">{heading}</h2>
  {body.map((element) => {
    if (element.type === 'p') return <p class="mt-3 leading-8 text-slate-600">{element.text}</p>;
    if (element.type === 'list') {
      const Tag = element.ordered ? 'ol' : 'ul';
      const classes = element.ordered ? 'mt-3 list-decimal space-y-2 pl-5 leading-8 text-slate-600 marker:font-semibold marker:text-blue-700' : 'mt-3 list-disc space-y-2 pl-5 leading-8 text-slate-600 marker:text-blue-700';
      return <Tag class={classes}>{element.items.map((item) => <li>{item}</li>)}</Tag>;
    }
    return <figure class="mt-5"><img src={element.src} alt={element.alt} loading="lazy" decoding="async" width="800" height="600" class="w-full rounded-xl ring-1 ring-slate-200" />{element.caption && <figcaption class="mt-2 text-sm text-slate-500">{element.caption}</figcaption>}</figure>;
  })}
</section>
