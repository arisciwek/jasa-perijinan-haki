---
import Icon from './Icon.astro';
const { id, heading, description } = Astro.props as { id?: string; heading: string; description: string };
---
<section id={id} class="mt-10 rounded-2xl border border-blue-100 bg-blue-50/60 p-6 md:p-8">
  <span class="inline-flex rounded-xl bg-white p-2.5 text-blue-700 shadow-sm"><Icon name="circle-check" size={24} /></span>
  <h2 class="mt-4 text-2xl font-extrabold tracking-tight text-slate-950">{heading}</h2>
  <p class="mt-3 leading-8 text-slate-600">{description}</p>
</section>
