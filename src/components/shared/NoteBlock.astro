---
/**
 * NoteBlock — block "note" (callout catatan/peringatan).
 *
 * Merender: ikon + judul singkat (opsional) + satu paragraf catatan,
 * dengan warna mengikuti `variant`. TIDAK punya heading → tidak masuk
 * "Daftar Isi"; posisinya mengikuti urutan blocks di frontmatter.
 *
 * Props:
 * - id?:     string — anchor HTML; TIDAK masuk TOC
 * - variant: "info" | "success" | "warning" | "danger" — default "info";
 *            menentukan warna border/latar + ikon bawaan
 * - title?:  string — label tebal singkat di atas teks, mis. "Perhatian"
 * - text:    string — isi catatan (wajib)
 * - icon?:   string — nama ikon Tabler; default per variant:
 *            info → "info", success → "circle-check",
 *            warning/danger → "alert-triangle" (daftar: Icon.astro)
 * - class?:  object — kelas tiap bagian; key yang tidak diisi memakai DEFAULT:
 *              section: "mt-10 flex items-start gap-4 rounded-2xl border p-5" + warna variant
 *              icon:    "inline-flex shrink-0 rounded-xl bg-white p-2.5 shadow-sm" + warna variant
 *              title:   "font-semibold text-slate-950"
 *              text:    "mt-0.5 leading-7 text-slate-600"
 *
 * Contoh pemakaian di frontmatter artikel (src/content/articles/*.md):
 *   blocks:
 *     - component: "note"
 *       variant: "warning"
 *       title: "Perhatian"
 *       text: "Klasifikasi kegiatan yang salah berdampak pada jenis izin dan kewajiban lanjutan."
 *
 * Variant menentukan warna: info (biru), success (hijau),
 * warning (amber), danger (merah).
 */
import Icon from './Icon.astro';
const { id, variant = 'info', title, text, icon, class: cls = {} } = Astro.props as { id?: string; variant?: string; title?: string; text: string; icon?: string; class?: Record<string, string> };
const variants: Record<string, { section: string; icon: string; iconClass: string }> = {
  info: { section: 'border-blue-200 bg-blue-50/60', icon: 'info', iconClass: 'text-blue-700' },
  success: { section: 'border-emerald-200 bg-emerald-50/60', icon: 'circle-check', iconClass: 'text-emerald-700' },
  warning: { section: 'border-amber-200 bg-amber-50/60', icon: 'alert-triangle', iconClass: 'text-amber-700' },
  danger: { section: 'border-red-200 bg-red-50/60', icon: 'alert-triangle', iconClass: 'text-red-700' },
};
const v = variants[variant] ?? variants.info;
const classes = {
  section: `mt-10 flex items-start gap-4 rounded-2xl border p-5 ${v.section}`,
  icon: `inline-flex shrink-0 rounded-xl bg-white p-2.5 shadow-sm ${v.iconClass}`,
  title: 'font-semibold text-slate-950',
  text: 'mt-0.5 leading-7 text-slate-600',
  ...cls,
};
---
<aside id={id} class={classes.section}>
  <span class={classes.icon}><Icon name={icon ?? v.icon} size={24} /></span>
  <div>
    {title && <p class={classes.title}>{title}</p>}
    <p class={classes.text}>{text}</p>
  </div>
</aside>
